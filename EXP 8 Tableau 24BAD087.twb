      <aliases enabled='yes' />
      <column caption='Sales Growth %' datatype='real' name='[Calculation_0691902515257344]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(([Calculation_0691902524280835] - SUM([Sales])) / SUM([Sales])) * 100' />
      </column>
      <column caption='Active Promotion Discount' datatype='real' name='[Calculation_0691902520254466]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Order Date] &gt;= DATE([Promotion Start Date]) AND [Order Date] &lt;= DATE([Promotion End Date]) &#13;&#10;THEN [Discount] &#13;&#10;ELSE 0 &#13;&#10;END' />
      </column>
      <column caption='Forecasted Sales' datatype='real' name='[Calculation_0691902524280835]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales]) * 1.12' />
      </column>
