      <aliases enabled='yes' />
      <column caption='Profit Margin %' datatype='real' name='[Calculation_0945332556034048]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Profit] / [Sales]) * 100' />
      </column>
      <column caption='Year-to-Date Sales' datatype='real' name='[Calculation_0945332556464129]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([Sales]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Sales Growth %' datatype='real' name='[Calculation_0945332556648450]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Sales]) - LOOKUP(SUM([Sales]), -1))&#13;&#10;/&#13;&#10;ABS(LOOKUP(SUM([Sales]), -1))&#13;&#10;*100'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Selected KPI' datatype='real' name='[Calculation_0945332560412676]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;&#13;&#10;WHEN &quot;Sales&quot; THEN SUM([Sales])&#13;&#10;&#13;&#10;WHEN &quot;Profit&quot; THEN SUM([Profit])&#13;&#10;&#13;&#10;END' />
      </column>
